APP_SECRET=524d40dcb911b8d13906f01336b989ee
###< symfony/framework-bundle ###

# Without this, Symfony debug mode defaults to on for APP_ENV=dev, which
# re-checks the freshness of every file the compiled DI container depends on
# (all of src/, all config/packages/*.yaml...) on EVERY request via stat().
# On this machine that check alone costs seconds because of how slow file
# access is over the Docker Desktop <-> Windows bind-mount (see chat).
# Trade-off: Symfony's detailed debug error page is replaced by a generic
# one. Flip this back to 1 temporarily when actively chasing a bug.
APP_DEBUG=0
