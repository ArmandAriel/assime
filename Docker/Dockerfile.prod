# Production image (Railway). Unlike Docker/Dockerfile (dev, bind-mounted
# source + manual composer install), this bakes the app in at build time.
FROM php:8.4-apache

RUN apt-get update && apt-get install -y \
    libpq-dev \
    libicu-dev \
    libzip-dev \
    unzip \
    git \
    && docker-php-ext-install intl pdo pdo_pgsql opcache zip \
    && rm -rf /var/lib/apt/lists/*

RUN a2enmod rewrite

# Written as a literal path rather than relying on Apache resolving
# ${APACHE_DOCUMENT_ROOT} from the environment at parse time -- that
# substitution silently failed here (apache2ctl -S kept reporting
# "/var/www/html" instead of "/var/www/html/public"), which meant
# AllowOverride never applied to the real document root and .htaccess
# (mod_rewrite) was silently ignored -- every clean URL 404'd.
RUN sed -ri -e 's!/var/www/html!/var/www/html/public!g' /etc/apache2/sites-available/*.conf \
    && sed -ri -e 's!/var/www/!/var/www/html/public!g' /etc/apache2/apache2.conf /etc/apache2/conf-available/*.conf \
    && printf '<Directory "/var/www/html/public">\n    AllowOverride All\n    Require all granted\n</Directory>\n' > /etc/apache2/conf-available/symfony.conf \
    && a2enconf symfony

RUN { \
    echo 'upload_max_filesize = 10M'; \
    echo 'post_max_size = 12M'; \
    echo 'opcache.enable = 1'; \
    echo 'opcache.validate_timestamps = 0'; \
    } > /usr/local/etc/php/conf.d/prod.ini

COPY --from=composer:latest /usr/bin/composer /usr/bin/composer

WORKDIR /var/www/html
COPY . .

# The "echo cache-bust" line forces this layer to actually re-run instead of
# silently reusing a stale cached layer from an earlier, broken build (seen
# on Railway: "composer install" kept showing as cached/0ms across deploys
# even after Dockerfile changes). Safe to remove once a deploy is confirmed
# healthy again.
RUN echo "cache-bust 2026-08-28-1" \
    && composer install --no-dev --optimize-autoloader --no-scripts --no-interaction \
    && ls -la vendor/autoload_runtime.php \
    && mkdir -p var public/uploads/listings config/jwt \
    && chown -R www-data:www-data /var/www/html

COPY Docker/entrypoint.prod.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh && sed -i 's/\r$//' /entrypoint.sh

ENV APP_ENV=prod

ENTRYPOINT ["/entrypoint.sh"]
CMD ["apache2-foreground"]
